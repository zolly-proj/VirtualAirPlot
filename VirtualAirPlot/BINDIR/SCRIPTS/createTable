CREATE TABLE VIRTUAL_AIR_PLOT_COORD(	
		BEACON_01_X_COORD INT not null,
		BEACON_01_Y_COORD INT not null,
		BEACON_01_Z_COORD INT not null,
		BEACON_02_X_COORD INT not null,
		BEACON_02_Y_COORD INT not null,
		BEACON_02_Z_COORD INT not null,
		BEACON_03_X_COORD INT not null,
		BEACON_03_Y_COORD INT not null,
		BEACON_03_Z_COORD INT not null,
		BEACON_01_LENGHT float8 not null,
		BEACON_02_LENGHT float8 not null,
		BEACON_03_LENGHT float8 not null
) PARTITION BY RANGE (BEACON_01_LENGHT);
CREATE TABLE VIRTUAL_AIR_PLOT_COORD_0000 PARTITION OF VIRTUAL_AIR_PLOT_COORD
    FOR VALUES FROM (0) TO (100);
CREATE TABLE VIRTUAL_AIR_PLOT_COORD_0100 PARTITION OF VIRTUAL_AIR_PLOT_COORD
    FOR VALUES FROM (100) TO (200);
CREATE TABLE VIRTUAL_AIR_PLOT_COORD_0200 PARTITION OF VIRTUAL_AIR_PLOT_COORD
    FOR VALUES FROM (200) TO (300);
CREATE TABLE VIRTUAL_AIR_PLOT_COORD_0300 PARTITION OF VIRTUAL_AIR_PLOT_COORD
    FOR VALUES FROM (300) TO (400);
CREATE TABLE VIRTUAL_AIR_PLOT_COORD_0400 PARTITION OF VIRTUAL_AIR_PLOT_COORD
    FOR VALUES FROM (400) TO (500);
CREATE TABLE VIRTUAL_AIR_PLOT_COORD_0500 PARTITION OF VIRTUAL_AIR_PLOT_COORD
    FOR VALUES FROM (500) TO (600);
CREATE TABLE VIRTUAL_AIR_PLOT_COORD_0600 PARTITION OF VIRTUAL_AIR_PLOT_COORD
    FOR VALUES FROM (600) TO (700);
CREATE TABLE VIRTUAL_AIR_PLOT_COORD_0700 PARTITION OF VIRTUAL_AIR_PLOT_COORD
    FOR VALUES FROM (700) TO (800);
CREATE TABLE VIRTUAL_AIR_PLOT_COORD_0800 PARTITION OF VIRTUAL_AIR_PLOT_COORD
    FOR VALUES FROM (800) TO (900);
CREATE TABLE VIRTUAL_AIR_PLOT_COORD_0900 PARTITION OF VIRTUAL_AIR_PLOT_COORD
    FOR VALUES FROM (900) TO (1000);
CREATE TABLE VIRTUAL_AIR_PLOT_COORD_1000 PARTITION OF VIRTUAL_AIR_PLOT_COORD
    FOR VALUES FROM (1000) TO (1100);
CREATE TABLE VIRTUAL_AIR_PLOT_COORD_1100 PARTITION OF VIRTUAL_AIR_PLOT_COORD
    FOR VALUES FROM (1100) TO (1200);
CREATE TABLE VIRTUAL_AIR_PLOT_COORD_1200 PARTITION OF VIRTUAL_AIR_PLOT_COORD
    FOR VALUES FROM (1200) TO (1300);
CREATE TABLE VIRTUAL_AIR_PLOT_COORD_1300 PARTITION OF VIRTUAL_AIR_PLOT_COORD
    FOR VALUES FROM (1300) TO (1400);
CREATE TABLE VIRTUAL_AIR_PLOT_COORD_1400 PARTITION OF VIRTUAL_AIR_PLOT_COORD
    FOR VALUES FROM (1400) TO (1500);
CREATE TABLE VIRTUAL_AIR_PLOT_COORD_1500 PARTITION OF VIRTUAL_AIR_PLOT_COORD
    FOR VALUES FROM (1500) TO (1600);
CREATE TABLE VIRTUAL_AIR_PLOT_COORD_1600 PARTITION OF VIRTUAL_AIR_PLOT_COORD
    FOR VALUES FROM (1600) TO (1700);
CREATE TABLE VIRTUAL_AIR_PLOT_COORD_1700 PARTITION OF VIRTUAL_AIR_PLOT_COORD
    FOR VALUES FROM (1700) TO (1800);
CREATE TABLE VIRTUAL_AIR_PLOT_COORD_1800 PARTITION OF VIRTUAL_AIR_PLOT_COORD
    FOR VALUES FROM (1800) TO (1900);
CREATE TABLE VIRTUAL_AIR_PLOT_COORD_1900 PARTITION OF VIRTUAL_AIR_PLOT_COORD
    FOR VALUES FROM (1900) TO (2000);